# Copy this file to .env for local development (emulator + scripts/).
# Never commit the real .env — some values below are genuine secrets when
# running scripts locally.
#
# In production, ANTHROPIC_API_KEY / USDA_FDC_API_KEY /
# REVENUECAT_SECRET_API_KEY are NOT read from this file — they're bound
# per-function from Firebase Secret Manager (see src/index.ts's `secrets`
# option), set once with:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set USDA_FDC_API_KEY
#   firebase functions:secrets:set REVENUECAT_SECRET_API_KEY
# This .env file only matters for local runs (emulator, scripts/, tests).

# --- App configuration ---
# Minutes a pendingAnalyses/{analysisId} document stays valid before
# clarify/recalculate reject it as expired (checked lazily on read).
ANALYSIS_TTL_MINUTES=60

# Max accepted size, in bytes, for an uploaded meal photo's decoded
# imageBase64. See src/lib/env.ts.
MAX_IMAGE_BYTES=5242880

# --- Anthropic Claude (AI vision provider) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# A current, vision-capable model. See src/services/ai/providers/anthropicVisionProvider.ts.
ANTHROPIC_VISION_MODEL=claude-sonnet-5
# Milliseconds before an AI vision request is aborted.
ANTHROPIC_REQUEST_TIMEOUT_MS=30000

# --- USDA FoodData Central ---
# Get a free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=

# --- RevenueCat (server-side entitlement verification) ---
# Both from the RevenueCat dashboard -> Project Settings -> API Keys.
# REVENUECAT_PROJECT_ID is shown at the top of that page (also in the
# dashboard URL, /projects/{project_id}/...). REVENUECAT_SECRET_API_KEY
# must be a v2 secret key (v1 keys do NOT work against the v2 REST API
# this app calls). This is a DIFFERENT key from the mobile app's public
# SDK keys (EXPO_PUBLIC_REVENUECAT_IOS_API_KEY / _ANDROID_API_KEY, set in
# calhow-mobile/.env) — never put the secret key in the mobile app's env.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
