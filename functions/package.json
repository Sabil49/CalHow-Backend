{
  "name": "calhow-functions",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src",
    "test": "vitest run",
    "smoke:usda": "tsx scripts/usdaSmokeTest.ts",
    "smoke:e2e": "tsx scripts/e2eSmokeTest.ts",
    "seed:demo": "tsx scripts/seedDemoAccount.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "@google-cloud/storage": "^8.2.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^22.20.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "sharp": "^0.35.4",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
